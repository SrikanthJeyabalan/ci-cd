
pipeline {
    agent any

    environment {
        AWS_REGION = 'ap-south-1'
        ECR_REPOSITORY = 'task-1'
        AWS_ACCOUNT_ID = "058264461329"
        REPOSITORY_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'SrikanthJeyabalan',
                    url: 'https://github.com/SrikanthJeyabalan/ci-cd.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -e
                    docker build -t my-nginx-image:latest .
                '''
            }
        }
        

        stage('Validate Environment') {
            steps {
                withCredentials([
                    string(credentialsId: 'AWS_ACCESS_KEY_ID',
                           variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'AWS_SECRET_ACCESS_KEY',
                           variable: 'AWS_SECRET_ACCESS_KEY')
                ]) {
                    sh '''
                        set -e
                        export AWS_DEFAULT_REGION=ap-south-1
                        export AWS_REGION=ap-south-1
        
                        aws --version
                        docker --version
                        aws sts get-caller-identity
                    '''
                }
            }
        }

        stage('Login to AWS ECR') {
            steps {
                sh '''
                    set -e
                    aws ecr get-login-password \
                        --region "$AWS_REGION" |
                    docker login \
                        --username AWS \
                        --password-stdin \
                        "$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com"
                '''
            }
        }

        stage('Push to ECR') {
            steps {
                sh '''
                    set -e
                    docker tag my-nginx-image:latest "$REPOSITORY_URI:latest"
                    docker push "$REPOSITORY_URI:latest"
                '''
            }
        }
    }

    post {
        success {
            echo 'Docker image pushed to ECR successfully!'
        }

        failure {
            echo 'Docker image push to ECR failed. Check the console output.'
        }

        always {
            sh 'docker logout "$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com" || true'
        }
    }
}
